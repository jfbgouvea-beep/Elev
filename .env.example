# Copie para .env e preencha. O .env nao vai para o git.

# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Modelo. Padrao: claude-opus-5 (mais capaz).
# Para reduzir custo em producao, teste claude-sonnet-5 e compare a qualidade
# antes de trocar de vez.
ELEV_MODEL=claude-opus-5

# Esforco de raciocinio na conversa: low | medium | high
# Atendimento e conversa: low costuma bastar e responde mais rapido.
ELEV_ESFORCO=low

# Onde ficam conversas e leads gravados.
ELEV_DIR_DADOS=data
